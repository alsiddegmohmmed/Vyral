{
  "name": "loyalty-clone-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node ../replica/design/build-tokens.mjs",
    "dev": "npm run assets && next dev -p 3100",
    "build": "npm run assets && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "contrast": "python3 ../replica/design/contrast.py ../replica/design/tokens.json",
    "test": "node --test tests/*.test.mjs",
    "assets": "node ../replica/design/build-tokens.mjs && node scripts/copy-wasm.mjs",
    "db:dev": "pglite-server -d .data/pglite -p 54321 -m 10 -e pgcrypto,citext,pg_trgm",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.0.22",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "barcode-detector": "^3.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "^16.2.9",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
