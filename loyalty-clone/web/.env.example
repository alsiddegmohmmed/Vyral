# Copy to .env.local and fill in. Never commit real values.
# Every integration is optional in development: without its keys the app runs
# and the feature reports "not configured".

# --- core ---------------------------------------------------------------
# Postgres. Dev default (npm run db:dev): postgres://postgres:postgres@127.0.0.1:54321/postgres
# Production: your Supabase (or any Postgres 15+) connection string, pooled.
DATABASE_URL=
PG_POOL_MAX=5
# Public origin, used in links, Apple webServiceURL and Google callbacks (https in production)
PUBLIC_BASE_URL=http://localhost:3100
# HMAC key for the QR codes on cards (long random string; rotating it invalidates every printed QR)
BARCODE_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Garuka <hello@your-domain.example>"

# --- payments: Paddle (international cards, merchant of record) ------------
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_GROWTH_MONTH=
PADDLE_PRICE_GROWTH_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=

# --- payments: Flutterwave Rwanda (MTN MoMo, Airtel Money, local cards) -----
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# --- Apple Wallet (organisation Apple Developer account, Pass Type ID) ------
# PEMs may be pasted with literal \n. WWDR must be the G4 intermediate.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PEM=

# --- Google Wallet (issuer account + service account with wallet_object.issuer) ----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY_PEM=

# --- counter phones (scanner) ----------------------------------------------
# Build id the scanner compares to spot a new deploy (set by CI; Vercel's
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA is used when this is empty). "dev" locally.
NEXT_PUBLIC_APP_VERSION=
# WhatsApp support link shown in scanner settings: a number in international
# format (e.g. +250788000000) or a full https link. Empty = "not set up yet".
SUPPORT_WHATSAPP=
